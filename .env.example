# Local development only. Copy to `.env.local` (git-ignored).
# In production the WordPress plugin holds these: the API key goes in
# wp-config.php or Settings > NapNox Prompts, and the contact details go in
# Settings > NapNox Prompts.
#
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Shown in the "free limit reached" modal during local development.
NAPNOX_CONTACT_EMAIL=contact@napnox.com
NAPNOX_CONTACT_WHATSAPP=
